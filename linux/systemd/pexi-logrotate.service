# Generated by linux/make-units.mjs; edit the table there, not this file.
# launchd twin: com.shin.logrotate

[Unit]
Description=Pexi logrotate: rotate the data-folder logs, keep 14 days (journald caps the server log itself)
After=network-online.target
Wants=network-online.target
OnFailure=pexi-alert@%n.service

[Service]
Type=oneshot
User=pexi
Group=pexi
UMask=0077
WorkingDirectory=/var/lib/pexi
EnvironmentFile=/etc/pexi/pexi.env
Environment=SHIN_CONFIG_FILE=/etc/pexi/pexi.env
Environment=NODE_NO_WARNINGS=1
ExecStart=/usr/sbin/logrotate -s /var/lib/pexi/logrotate.state /opt/pexi/live/linux/logrotate.conf
ExecStartPost=-/usr/local/bin/node /opt/pexi/live/linux/alert.mjs ok logrotate
ExecStartPost=/usr/local/bin/node /opt/pexi/live/mac/lib/health.mjs ok logrotate rotated by pexi-logrotate
TimeoutStartSec=10min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
SyslogIdentifier=pexi-logrotate
