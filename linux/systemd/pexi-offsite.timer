# Generated by linux/make-units.mjs; edit the table there, not this file.
# launchd twin: com.shin.offsite. Times are the server's local time (America/Toronto), same as the Mac.

[Unit]
Description=Pexi offsite schedule

[Timer]
OnCalendar=*-*-* 04:45:00
Persistent=true
AccuracySec=1s
Unit=pexi-offsite.service

[Install]
WantedBy=timers.target
