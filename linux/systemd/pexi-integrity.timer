# Generated by linux/make-units.mjs; edit the table there, not this file.
# launchd twin: com.shin.integrity. Times are the server's local time (America/Toronto), same as the Mac.

[Unit]
Description=Pexi integrity schedule

[Timer]
OnCalendar=*-*-* 03:30:00
Persistent=true
AccuracySec=1s
Unit=pexi-integrity.service

[Install]
WantedBy=timers.target
