# Generated by linux/make-units.mjs; edit the table there, not this file.
# launchd twin: com.shin.restoretest. Times are the server's local time (America/Toronto), same as the Mac.

[Unit]
Description=Pexi restoretest schedule

[Timer]
OnCalendar=Sun *-*-* 06:30:00
Persistent=true
AccuracySec=1s
Unit=pexi-restoretest.service

[Install]
WantedBy=timers.target
