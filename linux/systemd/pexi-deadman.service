# Generated by linux/make-units.mjs; edit the table there, not this file.
# launchd twin: com.shin.deadman

[Unit]
Description=Pexi deadman: every 60 s: read /api/health and ping the outside dead-man service (Healthchecks)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pexi
Group=pexi
UMask=0077
WorkingDirectory=/opt/pexi/live
EnvironmentFile=/etc/pexi/pexi.env
Environment=SHIN_CONFIG_FILE=/etc/pexi/pexi.env
Environment=NODE_NO_WARNINGS=1
ExecStart=/usr/local/bin/node /opt/pexi/live/scripts/deadman-probe.mjs
ExecStartPost=-/usr/local/bin/node /opt/pexi/live/linux/alert.mjs ok server-crash
TimeoutStartSec=45s
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
SyslogIdentifier=pexi-deadman
