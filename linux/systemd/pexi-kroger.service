# Generated by linux/make-units.mjs; edit the table there, not this file.
# launchd twin: com.shin.kroger (a collector: enabled only after the datacentre-IP probe passes, see linux/CUTOVER.md)

[Unit]
Description=Pexi kroger: daily Kroger shelf-price refresh, 6,000 product calls a run
After=network-online.target
Wants=network-online.target
OnFailure=pexi-alert@%n.service

[Service]
Type=oneshot
User=pexi
Group=pexi
UMask=0077
WorkingDirectory=/opt/pexi/live
EnvironmentFile=/etc/pexi/pexi.env
Environment=SHIN_CONFIG_FILE=/etc/pexi/pexi.env
Environment=NODE_NO_WARNINGS=1
ExecStart=/bin/sh /opt/pexi/live/mac/kroger-refresh.sh /etc/pexi/pexi.env
ExecStartPost=-/usr/local/bin/node /opt/pexi/live/linux/alert.mjs ok kroger
TimeoutStartSec=3h
MemoryMax=1G
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
SyslogIdentifier=pexi-kroger
