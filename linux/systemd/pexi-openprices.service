# Generated by linux/make-units.mjs; edit the table there, not this file.
# launchd twin: com.shin.openprices (a collector: enabled only after the datacentre-IP probe passes, see linux/CUTOVER.md)

[Unit]
Description=Pexi openprices: weekly Open Prices (Open Food Facts shelf prices) refresh, CAD and USD
After=network-online.target
Wants=network-online.target
OnFailure=pexi-alert@%n.service

[Service]
Type=oneshot
User=pexi
Group=pexi
UMask=0077
WorkingDirectory=/opt/pexi/live
EnvironmentFile=/etc/pexi/pexi.env
Environment=SHIN_CONFIG_FILE=/etc/pexi/pexi.env
Environment=NODE_NO_WARNINGS=1
ExecStart=/bin/sh /opt/pexi/live/mac/openprices-refresh.sh /etc/pexi/pexi.env
ExecStartPost=-/usr/local/bin/node /opt/pexi/live/linux/alert.mjs ok openprices
TimeoutStartSec=3h
MemoryMax=2G
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
SyslogIdentifier=pexi-openprices
