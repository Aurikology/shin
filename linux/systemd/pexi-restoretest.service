# Generated by linux/make-units.mjs; edit the table there, not this file.
# launchd twin: com.shin.restoretest

[Unit]
Description=Pexi restoretest: weekly: restore the newest off-site copy into a temp folder and check it
After=network-online.target
Wants=network-online.target
OnFailure=pexi-alert@%n.service

[Service]
Type=oneshot
User=pexi
Group=pexi
UMask=0077
WorkingDirectory=/opt/pexi/live/mac
EnvironmentFile=/etc/pexi/pexi.env
Environment=SHIN_CONFIG_FILE=/etc/pexi/pexi.env
Environment=NODE_NO_WARNINGS=1
ExecStart=/bin/sh /opt/pexi/live/mac/15-restore-test.sh
ExecStartPost=-/usr/local/bin/node /opt/pexi/live/linux/alert.mjs ok restoretest
TimeoutStartSec=2h
MemoryMax=2G
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
SyslogIdentifier=pexi-restoretest
