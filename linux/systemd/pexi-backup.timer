# Generated by linux/make-units.mjs; edit the table there, not this file.
# launchd twin: com.shin.backup. Times are the server's local time (America/Toronto), same as the Mac.

[Unit]
Description=Pexi backup schedule

[Timer]
OnCalendar=*-*-* 04:00:00
Persistent=true
AccuracySec=1s
Unit=pexi-backup.service

[Install]
WantedBy=timers.target
