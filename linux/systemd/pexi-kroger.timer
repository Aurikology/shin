# Generated by linux/make-units.mjs; edit the table there, not this file.
# launchd twin: com.shin.kroger. Times are the server's local time (America/Toronto), same as the Mac.

[Unit]
Description=Pexi kroger schedule

[Timer]
OnCalendar=*-*-* 08:30:00
Persistent=true
AccuracySec=1s
Unit=pexi-kroger.service

[Install]
WantedBy=timers.target
