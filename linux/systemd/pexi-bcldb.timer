# Generated by linux/make-units.mjs; edit the table there, not this file.
# launchd twin: com.shin.bcldb. Times are the server's local time (America/Toronto), same as the Mac.

[Unit]
Description=Pexi bcldb schedule

[Timer]
OnCalendar=Sun *-*-* 08:00:00
Persistent=true
AccuracySec=1s
Unit=pexi-bcldb.service

[Install]
WantedBy=timers.target
