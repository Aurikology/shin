# Generated by linux/make-units.mjs; edit the table there, not this file.
# launchd twin: com.shin.hammer (a collector: enabled only after the datacentre-IP probe passes, see linux/CUTOVER.md)

[Unit]
Description=Pexi hammer: weekly Project Hammer price refresh (needs about 5 GB free)
After=network-online.target
Wants=network-online.target
OnFailure=pexi-alert@%n.service

[Service]
Type=oneshot
User=pexi
Group=pexi
UMask=0077
WorkingDirectory=/opt/pexi/live
EnvironmentFile=/etc/pexi/pexi.env
Environment=SHIN_CONFIG_FILE=/etc/pexi/pexi.env
Environment=NODE_NO_WARNINGS=1
ExecStart=/bin/sh /opt/pexi/live/mac/hammer-refresh.sh /etc/pexi/pexi.env
ExecStartPost=-/usr/local/bin/node /opt/pexi/live/linux/alert.mjs ok hammer
TimeoutStartSec=3h
MemoryMax=3G
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
SyslogIdentifier=pexi-hammer
