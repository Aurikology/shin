# Generated by linux/make-units.mjs; edit the table there, not this file.
# launchd twin: com.shin.backup

[Unit]
Description=Pexi backup: nightly backup of the live databases, 14 nights kept (mac/07-backup.sh)
After=network-online.target
Wants=network-online.target
OnFailure=pexi-alert@%n.service

[Service]
Type=oneshot
User=pexi
Group=pexi
UMask=0077
WorkingDirectory=/opt/pexi/live/mac
EnvironmentFile=/etc/pexi/pexi.env
Environment=SHIN_CONFIG_FILE=/etc/pexi/pexi.env
Environment=NODE_NO_WARNINGS=1
ExecStart=/bin/sh /opt/pexi/live/mac/07-backup.sh /etc/pexi/pexi.env
TimeoutStartSec=1h
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
SyslogIdentifier=pexi-backup
