# Generated by linux/make-units.mjs; edit the table there, not this file.
# launchd twin: com.shin.logrotate. Times are the server's local time (America/Toronto), same as the Mac.

[Unit]
Description=Pexi logrotate schedule

[Timer]
OnCalendar=*-*-* 05:00:00
Persistent=true
AccuracySec=1s
Unit=pexi-logrotate.service

[Install]
WantedBy=timers.target
