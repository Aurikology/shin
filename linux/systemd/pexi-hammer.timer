# Generated by linux/make-units.mjs; edit the table there, not this file.
# launchd twin: com.shin.hammer. Times are the server's local time (America/Toronto), same as the Mac.

[Unit]
Description=Pexi hammer schedule

[Timer]
OnCalendar=Sun *-*-* 05:30:00
Persistent=true
