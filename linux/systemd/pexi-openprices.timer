# Generated by linux/make-units.mjs; edit the table there, not this file.
# launchd twin: com.shin.openprices. Times are the server's local time (America/Toronto), same as the Mac.

[Unit]
Description=Pexi openprices schedule

[Timer]
OnCalendar=Sun *-*-* 07:30:00
Persistent=true
AccuracySec=1s
Unit=pexi-openprices.service

[Install]
WantedBy=timers.target
