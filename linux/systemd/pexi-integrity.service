# Generated by linux/make-units.mjs; edit the table there, not this file.
# launchd twin: com.shin.integrity

[Unit]
Description=Pexi integrity: nightly PRAGMA integrity_check on every database and the free-disk check
After=network-online.target
Wants=network-online.target
OnFailure=pexi-alert@%n.service

[Service]
Type=oneshot
User=pexi
Group=pexi
UMask=0077
WorkingDirectory=/opt/pexi/live/mac
EnvironmentFile=/etc/pexi/pexi.env
Environment=SHIN_CONFIG_FILE=/etc/pexi/pexi.env
Environment=NODE_NO_WARNINGS=1
ExecStart=/bin/sh /opt/pexi/live/mac/run-job.sh integrity
ExecStartPost=-/usr/local/bin/node /opt/pexi/live/linux/alert.mjs ok integrity
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=full
PrivateTmp=yes
SyslogIdentifier=pexi-integrity
