# /etc/pexi/pexi.env -- the one environment file for the Pexi server and every job on the VPS.
#
# Install:  sudo install -m 0600 -o pexi -g pexi linux/pexi.env.example /etc/pexi/pexi.env   then fill the blanks.
# Read by: systemd (EnvironmentFile=) and by the mac/*.sh jobs (`. /etc/pexi/pexi.env`), so keep it plain:
# KEY=VALUE, no ${VAR}, no spaces around =, no export. Mode must stay 0600.
# Generated by linux/make-env-example.mjs from settings/src/index.ts. Do not hand-edit this example; regenerate it.
# Names only: no real value of a secret is ever written here or committed.

# ---- paths and addresses (set; change only if the layout changes) ----
# set by linux/provision.sh
NODE_BIN=/usr/local/bin/node
# the clone the server runs from (the Mac layout: ~/shin-live)
SHIN_REPO_DIR=/opt/pexi/live
# public address; the deploy check reads it (not a secret)
SHIN_TUNNEL_HOSTNAME=relay.anjiawenda.com
# file mode 0600 owned by pexi; the SAME password as the Mac repository, kept in his password manager
SHIN_RESTIC_PASSWORD_FILE=/etc/pexi/restic-password
# apt installs it here
RESTIC_BIN=/usr/bin/restic
# hours before the off-site copy counts as stale
SHIN_OFFSITE_MAX_AGE_H=36
# integrity job fails below this much free disk (75 GB box)
SHIN_DISK_MIN_GB=10
# copy ~/shin-privacy/request-log.csv from the Mac: restores re-run deletions from it
SHIN_REQUEST_LOG=/var/lib/pexi/privacy/request-log.csv
# where Mac collectors drop price files for the server to ingest (linux/CUTOVER.md, "what stays on the Mac")
SHIN_INBOX_DIR=/var/lib/pexi/inbox
# where a commit is tested before it goes live
SHIN_STAGE_DIR=/opt/pexi/stage
# set to 1 at cutover: the deploy check then also requires the public address to show the new process
SHIN_DEPLOY_CHECK_PUBLIC=0
PORT=4173
SHIN_DATA_DIR=/var/lib/pexi
SHIN_CATALOGUE=/var/lib/pexi/catalogue.db
SHIN_SCANS=/var/lib/pexi/scans.db
SHIN_CORRECTIONS=/var/lib/pexi/corrections.db
SHIN_PRICES=/var/lib/pexi/prices.db
SHIN_GAPS=/var/lib/pexi/gaps.db
SHIN_REPEAT_CACHE=/var/lib/pexi/repeat-cache.db
SHIN_USER_CATALOGUE=/var/lib/pexi/user-catalogue.db
SHIN_PEOPLE_DB=/var/lib/pexi/people.db
SHIN_PHOTOS=/var/lib/pexi/photos
SHIN_SHUTTER_DIR=/var/lib/pexi/shutter
SHIN_ACCESS_LOG=/var/lib/pexi/access.log
SHIN_SPEND_CAP_STORE_PATH=/var/lib/pexi/spend-cap.json
SHIN_RANGE_ASK_STORE_PATH=/var/lib/pexi/range-ask.json
SHIN_PACK_READ_STORE_PATH=/var/lib/pexi/pack-read.json
SHIN_HEALTH_DIR=/var/lib/pexi/health
SHIN_BACKUP_DIR=/var/lib/pexi/backup

# ---- secrets (blank here; fill on the server; each says where the value comes from) ----
# SECRET. the Mac /Users/worker/shin/mac/config.env (same key), or console.anthropic.com > API keys
ANTHROPIC_API_KEY=
# SECRET. healthchecks.io check "pexi-server" > its ping URL (docs/readiness/needs-jamin.md)
SHIN_DEADMAN_URL=
# SECRET. healthchecks.io > project Settings > Ping key (one key, one check per failing job: see linux/README.md, Alerts)
SHIN_HC_PING_KEY=
# SECRET. optional: any HTTPS URL that takes a POST with the text (e.g. an ntfy.sh topic); used as well as Healthchecks
SHIN_ALERT_URL=
# SECRET. the Mac config.env, or developer.kroger.com > the Pexi app
KROGER_CLIENT_ID=
# SECRET. same place as KROGER_CLIENT_ID
KROGER_CLIENT_SECRET=
# SECRET. not needed: the password file is used. Backend keys (B2, S3, ...) go below as the target requires
RESTIC_PASSWORD=
# SECRET. make one: openssl rand -hex 32; the same value goes in the Mac collectors' config as SHIN_IMPORT_TOKEN
SHIN_IMPORT_TOKEN=
# SECRET. the Mac config.env, or RevenueCat dashboard > Project settings > API keys (secret key)
REVENUECAT_SECRET_KEY=
# SECRET. COPY the Mac value. Never make a new one: it would break the continuity of every hashed address
SHIN_NETWORK_SALT=
# SECRET. the Mac config.env (same token; the PC scripts use it)
SHIN_ADMIN_TOKEN=
# SECRET. the Mac config.env, or Voyage AI dashboard
VOYAGE_API_KEY=
# SECRET. the Mac config.env, or developer.bestbuy.com
BESTBUY_API_KEY=
# SECRET. the Mac config.env (same value)
EBAY_CLIENT_ID=
# SECRET. the Mac config.env (same value)
EBAY_APP_ID=
# SECRET. the Mac config.env, or developer.ebay.com keyset
EBAY_CLIENT_SECRET=
# SECRET. the Mac config.env (same value)
EBAY_CERT_ID=
# SECRET. the Mac config.env, or the SoldComps account
SOLDCOMPS_API_KEY=

# ---- optional (the code has its own default; uncomment to override) ----
# leave empty on Linux (the PC-Mac mailbox does not exist here); alerts go over HTTPS
# SHIN_HEALTH_MAIL=
# Jamin picks the off-site target (needs-jamin.md); same value as on the Mac
# SHIN_RESTIC_REPOSITORY=
# git URL of the repo the deploy checker pulls main from (read-only deploy key)
# SHIN_DEPLOY_REMOTE=
# default: '1' (on)
# SHIN_BARCODE_OWN_PRICES=
# default: 10 (CAD, soft cap)
# SHIN_PHOTO_DAILY_CAP_CAD=
# default: 10x the soft cap
# SHIN_PHOTO_HARD_CAP_CAD=
# default: unset/empty/0/NaN -> unlimited (off)
# SHIN_FREE_SCANS_PER_WEEK=
# default: off; 'on' enables
# SHIN_SHUTTER_LOG=
# default: 200
# SHIN_RATE_CODE_PER_10MIN=
# default: 1500
# SHIN_RATE_CODE_PER_DAY=
# default: 90
# SHIN_RATE_IP_PER_10MIN=
# default: 600
# SHIN_RATE_IP_PER_DAY=
# default: 40 (Claude-backed answers per phone per day; the 429 says when it frees)
# SHIN_CAP_CLAUDE_DEVICE_PER_DAY=
# default: 100 (Claude-backed answers per address per day; an IPv6 address counted as its /64)
# SHIN_CAP_CLAUDE_IP_PER_DAY=
# default: 60 (typed prices and corrections one phone may send in a day)
# SHIN_CAP_PRICE_DEVICE_PER_DAY=
# default: 300 (typed prices and corrections one address may send in a day)
# SHIN_CAP_PRICE_IP_PER_DAY=
# default: on since 2026-09-28; only '0', 'off' or 'false' turns it off
# SHIN_CATALOGUE_FIRST=
# default: 10000 (asks per UTC month, raised from 1000 on 2026-11-21 with the move to Claude Haiku 5.5; no d...
# SHIN_RANGE_ASK_MONTHLY_CAP=
# default: 2000000 (highest high_cents accepted)
# SHIN_RANGE_ASK_CEILING_CENTS=
# default: 300 (frames Claude reads per UTC month; 0 turns the read off)
# SHIN_PACK_READ_MONTHLY_CAP=
# default: unset -> no device is a developer; only the admin token may ask for the pack read
# SHIN_DEVELOPER_DEVICES=
# default: unset -> loopback only (127.0.0.1 and ::1); '0.0.0.0' or '::' opens the LAN on purpose
# SHIN_BIND_HOST=
# default: unset -> decided from embedded row count
# SHIN_VECTORS=
# default: unset -> no source excluded; comma-separated switch names (kroger, hammer, openfoodfacts, icecat,...
# SHIN_EXCLUDED_SOURCES=
# default: unset -> off; '1' keeps Icecat rows out of the placement run's embeddings, word-search neighbours...
# SHIN_ICECAT_NO_AI=
# default: https://overpass-api.de/api/interpreter
# SHIN_OVERPASS=
# default: 'python' on Windows, 'python3' elsewhere (printout intake's PDF reader)
# SHIN_PYTHON=
# default: unset; '1' believes x-shin-plus when no RevenueCat key is set
# SHIN_PLUS_TRUST_CLIENT=
# default: 6000 (the address ceiling, an IPv6 address counted as its /64; each phone has its own 1200)
# SHIN_RATE_DOOR_IP_PER_10MIN=
# default: 75000 (the address ceiling; each phone has its own 15000)
# SHIN_RATE_DOOR_IP_PER_DAY=
# default: 2000 (raised from 150 on 2026-11-21; an IPv6 address counted as its /64; phones new today also sh...
# SHIN_FREE_SCANS_PER_IP_DAY=
# default: unset -> on; 'off' stops typed prices and learned picks from changing any shown answer (they are ...
# SHIN_SHOPPER_VOICE=
# default: 10 (health reports a problem under this much free disk)
# SHIN_WATCH_MIN_FREE_GB=
# default: 60 (health reports a problem when Open Prices was last loaded longer ago; 0 turns the check off)
# SHIN_WATCH_OPENPRICES_DAYS=
# default: null (keep forever)
# SHIN_PHOTO_RETENTION_DAYS=
# default: unset/empty -> no invite code required
# SHIN_INVITE_CODE=
# default: empty string -> no named invites tracked
# SHIN_INVITES=
# default: unset -> no database required at boot
# SHIN_REQUIRE_DB=
# default: the source's own DEFAULT_BASE
# BESTBUY_API_BASE=
# default: production base, or sandbox if EBAY_ENV=sandbox
# EBAY_API_BASE=
# default: unset -> production base (not 'sandbox')
# EBAY_ENV=
# default: the source's own DEFAULT_BASE
# SOLDCOMPS_API_BASE=
# default: unset or malformed -> no minimum (every build is supported); format 'YYYY-MM-DD.N', the app's APP...
# SHIN_APP_MIN_VERSION=
# default: unset -> nothing switched off; a comma list of feature names the app knows (watchlist, share, pas...
# SHIN_APP_FEATURES_OFF=
