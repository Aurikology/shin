{
  "//": "server.ts is the only TypeScript outside the spine, and until this file existed it was never typechecked. It runs on Node's type stripping, so nothing at runtime would ever tell us about a type error. Types are borrowed from the spine's install rather than duplicating a devDependency for one file.",
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "typeRoots": ["../spine/node_modules/@types"],
    "types": ["node"]
  },
  /* src/** is listed explicitly because `npm run typecheck` used to reach a file in src
   * only if server.ts imported it. Anything in src that nothing imports yet -- a route
   * written before it is registered, for instance -- was silently never compiled, and the
   * command still printed a clean result. Verified 2026-09-05: all of src typechecks. */
  "include": ["server.ts", "src/**/*.ts", "scripts/**/*.mjs"]
}
