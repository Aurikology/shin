<?xml version="1.0" encoding="UTF-8"?>
<!--
  mac/launchd-daemons/com.shin.bcldb.plist

  Sundays 08:00: the weekly check for the newest BC Liquor monthly price list (mac/bcldb-refresh.sh).
  A month already loaded is skipped, so a new month is loaded once, within a week of BC publishing it.
  Clear of the Open Prices job (07:30) and kroger (08:30). Launch review 2026-11-27 G5: this list had no job.

  A LaunchDAEMON: installed by mac/10-boot-survival.sh into /Library/LaunchDaemons, started by launchd at
  boot with nobody logged in, and run as __SHIN_USER__ (UserName), never as root. The tokens
  __SHIN_REPO_DIR__, __SHIN_MAC_DIR__, __SHIN_USER__, __SHIN_HOME__ and __NODE_BIN__ are filled in by that script; do not load
  this file as it is. launchd gives a job almost no environment, so HOME, USER, LOGNAME and PATH are set below.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shin.bcldb</string>

    <key>UserName</key>
    <string>__SHIN_USER__</string>

    <key>Umask</key>
    <integer>63</integer>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>__SHIN_MAC_DIR__/bcldb-refresh.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__SHIN_MAC_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__SHIN_HOME__</string>
        <key>USER</key>
        <string>__SHIN_USER__</string>
        <key>LOGNAME</key>
        <string>__SHIN_USER__</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__SHIN_MAC_DIR__/logs/bcldb.out.log</string>

    <key>StandardErrorPath</key>
    <string>__SHIN_MAC_DIR__/logs/bcldb.err.log</string>
</dict>
</plist>
