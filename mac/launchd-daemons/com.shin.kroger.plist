<?xml version="1.0" encoding="UTF-8"?>
<!--
  mac/launchd-daemons/com.shin.kroger.plist

  Daily 08:30: the Kroger shelf-price refresh (mac/kroger-refresh.sh), 6,000 product calls a run, the barcodes Kroger
  priced longest ago first. Clear of integrity (03:30), backup (04:00), offsite (04:45), logrotate (05:00),
  and the Sunday jobs hammer (05:30), restoretest (06:30) and openprices (07:30).

  A LaunchDAEMON: installed by mac/10-boot-survival.sh into /Library/LaunchDaemons, started by launchd at
  boot with nobody logged in, and run as __SHIN_USER__ (UserName), never as root. The tokens
  __SHIN_REPO_DIR__, __SHIN_MAC_DIR__, __SHIN_USER__, __SHIN_HOME__ and __NODE_BIN__ are filled in by that script; do not load
  this file as it is. launchd gives a job almost no environment, so HOME, USER, LOGNAME and PATH are set below.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shin.kroger</string>

    <key>UserName</key>
    <string>__SHIN_USER__</string>

    <key>Umask</key>
    <integer>63</integer>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>__SHIN_MAC_DIR__/kroger-refresh.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__SHIN_MAC_DIR__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__SHIN_HOME__</string>
        <key>USER</key>
        <string>__SHIN_USER__</string>
        <key>LOGNAME</key>
        <string>__SHIN_USER__</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>30</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__SHIN_MAC_DIR__/logs/kroger.out.log</string>

    <key>StandardErrorPath</key>
    <string>__SHIN_MAC_DIR__/logs/kroger.err.log</string>
</dict>
</plist>
