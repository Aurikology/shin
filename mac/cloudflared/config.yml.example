# mac/cloudflared/config.yml.example
#
# The primary tunnel config, now that cloudflared login has already been
# run on the Mac (see mac/01-cloudflare-tunnel.md's "Already done"
# section) and produced a certificate. Copy this to
# ~/.cloudflared/config.yml on the Mac and fill in the two placeholders
# after running:
#
#   cloudflared tunnel create shin-beta
#   cloudflared tunnel route dns shin-beta relay.anjiawenda.com
#
# The create command prints a tunnel UUID and writes
# ~/.cloudflared/<UUID>.json -- that JSON file is the tunnel's own
# credential and it stays inside ~/.cloudflared/ on the Mac, never copied
# into this repo.

tunnel: __TUNNEL_UUID__
credentials-file: /Users/worker/.cloudflared/__TUNNEL_UUID__.json

ingress:
  - hostname: relay.anjiawenda.com
    service: http://localhost:4173
  - service: http_status:404
