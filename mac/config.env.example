# mac/config.env.example
#
# The one file that holds every placeholder for the Mac beta setup. Copy it
# to mac/config.env (gitignored, never commit it), fill in the real values,
# then every script in mac/ sources it with:
#   set -a; source mac/config.env; set +a
#
# This file itself holds no secrets, only placeholder names. The filled copy
# (mac/config.env) never goes in the repo and never goes in mac/ if that
# directory is ever committed as-is -- keep the real file outside git's view
# or add it to .gitignore before it is filled in.
#
# PROVENANCE of the domain value below, since a real hostname sitting in a
# placeholder file deserves a traceable source rather than a guess: a
# session on the founder's Mac installed cloudflared 2026.9.1 via Homebrew,
# ran the browser login against his already-signed-in Cloudflare account,
# and confirmed the account carries exactly one zone -- anjiawenda.com,
# Active, Free plan -- which is therefore the only zone the tunnel can sit
# under. A hostname is not a secret (it is visible in the network traffic
# of every request the app makes), so it is written here as the real
# value rather than a placeholder; the token, the invite code and the
# model key below stay placeholders, since those three are the ones that
# actually need to stay out of the repo.

# ---- domain and tunnel (item 1a) ----
# The apex domain the founder already holds at Cloudflare (the one used for
# the paused ACT venture). Mail forwarding lives on this apex; never touch
# apex records, only the one subdomain below.
SHIN_DOMAIN_APEX=anjiawenda.com

# A neutral subdomain that names nothing about the product. Pick something
# that reads as infrastructure, not a product name, e.g. "relay" or "edge".
SHIN_TUNNEL_SUBDOMAIN=relay

# Full public hostname testers will hit. Must equal
# ${SHIN_TUNNEL_SUBDOMAIN}.${SHIN_DOMAIN_APEX}. Written out separately so
# scripts do not have to string-concat it.
SHIN_TUNNEL_HOSTNAME=relay.anjiawenda.com

# Name of the named tunnel as it appears in the Cloudflare CLI / dashboard.
CLOUDFLARE_TUNNEL_NAME=shin-beta

# ---- server (items 1b, 1e, 1j) ----
# Local port the Node server listens on. The tunnel's public hostname maps
# to http://localhost:${PORT} on the Mac.
PORT=4173

# Absolute path to this checkout of the shin repo on the Mac. FACT, not a
# placeholder: a session on the Mac confirmed the repo is already cloned at
# exactly this path (git@gitlab.com:shin3223636/shin.git, main, authenticated
# as @jaminke through an SSH key already on that machine). Change this only
# if that Mac's home directory is not actually /Users/worker.
SHIN_REPO_DIR=/Users/worker/shin

# Absolute path to the node binary to run the server with. launchd does not
# read the interactive shell's PATH (no Homebrew shellenv, no nvm), so a
# bare "node" is not reliable inside mac/run-server.sh once it runs under
# launchd instead of a terminal. Find the real path with:
#   which node
# (or, if mac/02-install-node.sh's nvm fallback was used: nvm which 24.14.0)
# and paste the full path here, e.g. /opt/homebrew/bin/node or
# /Users/worker/.nvm/versions/node/v24.14.0/bin/node. Leave blank only if
# node is confirmed reachable from a launchd-run script without it (check
# by loading the launch agent once and reading its error log before trusting
# a blank value).
NODE_BIN=

# Data file locations on the Mac. Point these at a stable, backed-up
# directory outside the repo checkout so a `git pull` or a reinstall never
# touches live data. Create the directory before first run. Every one of
# these is set EXPLICITLY here on purpose, even the ones whose code has a
# safe-looking absolute-path default: a process manager (launchd) does not
# start in the directory a person assumes, and two of these five
# (app/src/scans.ts's own default and catalogue/src/gaps.ts's default) fall
# back to a plain relative string ("data/scans.db", "data/gaps.db") if
# nothing sets them, which resolves against launchd's working directory,
# not this repo. Never rely on the default; always set the six below.
SHIN_DATA_DIR=/Users/worker/shin-data
SHIN_CATALOGUE=${SHIN_DATA_DIR}/catalogue.db
SHIN_SCANS=${SHIN_DATA_DIR}/scans.db
SHIN_CORRECTIONS=${SHIN_DATA_DIR}/corrections.db
SHIN_PRICES=${SHIN_DATA_DIR}/prices.db
SHIN_GAPS=${SHIN_DATA_DIR}/gaps.db

# The OpenStreetMap Overpass endpoint app/src/stores.ts calls to find nearby
# stores. Its own default (https://overpass-api.de/api/interpreter) is
# already a real absolute URL, not a relative path, so this is safe to
# leave unset for the beta -- listed here so it is not missed, not because
# it needs a different value. Set it only if the public endpoint proves
# unreliable during testing and a mirror or a self-hosted instance is
# swapped in instead.
SHIN_OVERPASS=

# "on" forces the vector search arm, "off" forces text-only, unset lets the
# server decide from row count (see app/server.ts). Leave unset unless a
# specific check needs one or the other pinned.
SHIN_VECTORS=

# The model the identify package calls. Leave blank to take the package's
# own default (identify/src/model.ts, PICK_MODEL) unless item 14's eval
# names a different tier for the beta.
SHIN_MODEL_PICK=

# The API key for whichever model console item I4 opens the card on.
# identify/src/model.ts reads ANTHROPIC_API_KEY through the SDK's own
# environment lookup (checked in the mac-prep read of that file: the SDK
# error-detection regex matches "ANTHROPIC_API_KEY", the SDK client reads it
# itself, there is no separate SHIN_-prefixed name for it).
# HE TYPES THIS ONE HIMSELF, and no session may do it for him. The Mac session
# working on this repo is forbidden by its own machine's rules from holding an
# API key at all, or even from asking for one, so there is no path where the key
# reaches this file through an agent. That is the correct shape anyway: it is his
# key, on his card, and a credential that has passed through a transcript is a
# credential that has been copied. He opens this file on the Mac, pastes the key,
# saves. Everything either side of that line is scripted.
ANTHROPIC_API_KEY=paste-the-console-key-here

# The beta invite code, item 1j. VERIFIED WIRED, not just defined:
# app/server.ts imports INVITE_EXEMPT, INVITE_HEADER, INVITE_REFUSAL and
# inviteAllows and calls inviteAllows(req.headers[INVITE_HEADER]) guarding
# every /api/ path except the exempt /api/health. The server reads
# SHIN_INVITE_CODE (unset or empty means no code is required, so nothing
# else breaks until this is set) and a caller sends it back in a request
# header named x-shin-invite. mac/09-e12-checks.sh's third check can be
# trusted as written.
SHIN_INVITE_CODE=paste-the-real-invite-code-here

# ---- moving the catalogue from Windows to the Mac (item 1d) ----
# The catalogue is NOT in git (the whole repo clone measures 10 MB; the
# catalogue alone is over 4 GB), so it is the one thing in this whole setup
# that still has to travel from this Windows laptop to the Mac by hand.
# See mac/04-catalogue-acquire.md for the full procedure and why. This
# Windows laptop, reachable from the Mac over the same LAN, needs an SSH
# server running (OpenSSH Server, a Windows 11 optional feature, off by
# default) for the rsync pull that script uses; if no SSH path exists, use
# an external drive instead and skip straight to the checksum step against
# the drive-copied files.
WINDOWS_SOURCE_USER=founder

# Left EMPTY on purpose, not filled with a placeholder that looks like a
# real address. A prior draft of this line used 192.168.1.0, which is a
# network address, not a host anything could actually connect to --
# someone who pastes the file's shape without reading the comment would
# get a connection-refused or a timeout that explains nothing. Left empty,
# mac/04-catalogue-acquire.md's transfer step checks this and fails with a
# named sentence ("WINDOWS_SOURCE_HOST is not set") instead, which is a
# better failure than a plausible-looking wrong address. Fill in the real
# LAN address or hostname of this Windows laptop (ipconfig on Windows, look
# for the IPv4 Address under the active adapter) before running that step.
WINDOWS_SOURCE_HOST=
WINDOWS_CATALOGUE_DATA_PATH=/c/shin/catalogue/data

# ---- backup (item 1g) ----
# Where the nightly backup lands. Either a path to the Windows laptop
# (mounted as an SMB share on the Mac, e.g. /Volumes/laptop/shin-backup) or
# a local folder synced by a cloud client (Dropbox/iCloud Drive/Drive) that
# is already running on the Mac. This script does not start a sync client;
# it only writes into the folder the sync client watches.
SHIN_BACKUP_DIR=/Users/worker/Dropbox/shin-backup
