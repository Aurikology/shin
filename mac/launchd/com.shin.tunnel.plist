<?xml version="1.0" encoding="UTF-8"?>
<!--
  mac/launchd/com.shin.tunnel.plist

  FALLBACK, NOT THE PRIMARY PATH. mac/01-cloudflare-tunnel.md's own step 4
  is `sudo cloudflared service install` (no token: cloudflared already has
  a certificate on this Mac from `cloudflared tunnel login`), which
  installs and loads its OWN launchd daemon (com.cloudflare.cloudflared)
  automatically, reading ~/.cloudflared/config.yml -- do not also load
  this file in that case, the two would fight over the same port.

  This file exists only for the rarer case where `cloudflared service
  install` itself cannot be used and the tunnel has to be launched by hand
  against mac/cloudflared/config.yml.example instead. Template:
  __SHIN_REPO_DIR__ and __TUNNEL_NAME__ are
  replaced by mac/05-install-launchd.sh before this is copied into
  ~/Library/LaunchAgents/.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shin.tunnel</string>

    <key>ProgramArguments</key>
    <array>
        <string>__CLOUDFLARED_BIN__</string>
        <string>tunnel</string>
        <string>run</string>
        <string>__TUNNEL_NAME__</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__SHIN_REPO_DIR__/mac/logs/tunnel.out.log</string>

    <key>StandardErrorPath</key>
    <string>__SHIN_REPO_DIR__/mac/logs/tunnel.err.log</string>
</dict>
</plist>
