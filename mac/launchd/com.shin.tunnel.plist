<?xml version="1.0" encoding="UTF-8"?>
<!--
  mac/launchd/com.shin.tunnel.plist

  FALLBACK ONLY. If the dashboard token path is used (mac/01-cloudflare-tunnel.md,
  step 6: `sudo cloudflared service install <token>`), that command installs
  and loads its OWN launchd daemon (com.cloudflare.cloudflared) automatically
  -- do not also load this file, the two would fight over the same port.

  This file is only for the locally-managed fallback (mac/cloudflared/config.yml.example):
  it runs `cloudflared tunnel run` against that hand-written config instead
  of a dashboard token. Template: __SHIN_REPO_DIR__ and __TUNNEL_NAME__ are
  replaced by mac/05-install-launchd.sh before this is copied into
  ~/Library/LaunchAgents/.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.shin.tunnel</string>

    <key>ProgramArguments</key>
    <array>
        <string>__CLOUDFLARED_BIN__</string>
        <string>tunnel</string>
        <string>run</string>
        <string>__TUNNEL_NAME__</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__SHIN_REPO_DIR__/mac/logs/tunnel.out.log</string>

    <key>StandardErrorPath</key>
    <string>__SHIN_REPO_DIR__/mac/logs/tunnel.err.log</string>
</dict>
</plist>
